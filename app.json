{
  "expo": {
    "owner": "nexusbinary",
    "name": "Aviora",
    "slug": "aviora",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3C6E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aviora requires access to your camera to let you take photos of your boarding passes or passport for assistance verification.",
        "NSPhotoLibraryUsageDescription": "Aviora requires access to your photo library to let you upload documents and proof of assistance eligibility."
      }
    },
    "android": {
      "package": "com.internship.aviora",
      "adaptiveIcon": {
        "backgroundColor": "#1A3C6E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aviora to access your photos to select document verification uploads.",
          "cameraPermission": "Allow Aviora to use your camera to photograph travel document verification copies."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aviora to use your camera for QR scanning and document capture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A3C6E"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "EXPO_FIREBASE_API_KEY": "AIzaSyAPd6FB3N1oXa4W0ypynMObNhDSUjRRTUc",
      "EXPO_FIREBASE_AUTH_DOMAIN": "mobile-app-intern.firebaseapp.com",
      "EXPO_FIREBASE_PROJECT_ID": "mobile-app-intern",
      "EXPO_FIREBASE_STORAGE_BUCKET": "mobile-app-intern.firebasestorage.app",
      "EXPO_FIREBASE_MESSAGING_SENDER_ID": "661987865346",
      "EXPO_FIREBASE_APP_ID": "1:661987865346:web:28d0f82453a4b8f906081b",
      "EXPO_GRIDFS_API_URL": "https://aviora-1.onrender.com",
      "EXPO_GRIDFS_API_KEY": "change-this-dev-upload-token",
      "eas": {
        "projectId": "04c5aef3-01ce-48bf-9def-11169f2e339f"
      }
    }
  }
}
