# MongoDB GridFS file upload API
# Use your computer LAN IP when testing on a real phone, e.g. http://192.168.1.8:4000
EXPO_GRIDFS_API_URL=https://aviora-1.onrender.com
EXPO_GRIDFS_API_KEY=change-this-dev-upload-token

# Server-only MongoDB variables. Do not expose MONGODB_URI in a production mobile build.
GRIDFS_API_PORT=4000
GRIDFS_API_KEY=change-this-dev-upload-token
GRIDFS_PUBLIC_BASE_URL=http://localhost:4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/aviora?retryWrites=true&w=majority
MONGODB_DB_NAME=aviora
GRIDFS_BUCKET_NAME=request_documents

